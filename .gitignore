# ── Heavy artifacts: distributed via releases, never committed ─────────
# See specs/replication-package/spec.md — "Heavy artifacts are distributed
# with a citable identifier". Checksums are committed; the payloads are not.
models/
checkpoints/
data/cache/
artifacts/runs/
*.safetensors
*.ckpt
*.pt
*.bin

# ── Terraform ─────────────────────────────────────────────────────────
# State can contain secrets and is never committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# The pinned target is committed on purpose: it carries no secret, and it is what
# the subscription guard checks against.
!infra/target.tfvars
.terraform.lock.hcl.bak
crash.log

# ── Azure / credentials ───────────────────────────────────────────────
.azure/
*.pem
*.key
.env
.env.*
!.env.example

# ── Library scratch output ────────────────────────────────────────────
# CatBoost writes a training log directory into the working directory on every
# fit. Build noise, never a result.
catboost_info/

# ── Per-machine tool settings ─────────────────────────────────────────
# settings.json is shared project config; settings.local.json is per-machine
# and must not travel with the replication package.
.claude/settings.local.json

